<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:ignore="ForegroundServicesPolicy" />
    <!-- 穿戴设备（小米 XMS / 蓝牙）：Android 14+ 的 connectedDevice 前台服务必须持有其中之一 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:ignore="BackgroundLocationPolicy" /> <!-- API 34 必须 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" /> <!-- API 33 以下 -->
    <application
        android:name=".tApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsPictureInPicture="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.WGProAndroid"
        android:usesCleartextTraffic="false"
        tools:ignore="HardcodedDebugMode"
        tools:targetApi="33">
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation"
            android:theme="@style/zxing_CaptureTheme"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:exported="false" />
        <activity
            android:name=".ui.function.debug.CrashActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".ui.function.debug.TestActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:exported="false" />
        <activity android:name=".ui.function.community.ResourceDetailActivity" android:launchMode="singleTop" android:screenOrientation="portrait" android:exported="false" />
        <activity
            android:name=".ui.function.ScanQRActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:launchMode="singleTop"
            android:exported="false"
            tools:ignore="Instantiatable" />
        <activity
            android:name=".ui.function.account.AccMangerActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:launchMode="singleTop"
            android:exported="false" />
        <activity
            android:name=".ui.function.account.UserDetailActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:launchMode="singleTask"
            android:exported="false" />
        <activity android:name=".ui.function.device.AddDeviceActivity" android:exported="false" android:launchMode="singleTop" android:screenOrientation="portrait" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".ui.function.community.AccountListActivity" android:exported="false" android:launchMode="singleTop" android:screenOrientation="portrait" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".ui.function.community.SearchActivity" android:exported="false" android:launchMode="singleTop" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.function.community.ContactActivity" android:exported="false" android:launchMode="singleTop" android:screenOrientation="portrait" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".ui.function.community.NotificationActivity" android:exported="false" android:launchMode="singleTask" android:screenOrientation="portrait" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".ui.function.community.ChatActivity" android:exported="false" android:launchMode="singleTask" android:screenOrientation="portrait" android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name=".ui.function.community.DynamicDetailActivity" android:exported="false" android:launchMode="singleTop" android:screenOrientation="portrait" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".ui.function.community.AppDetailActivity" android:exported="false" android:launchMode="singleTop" android:screenOrientation="portrait" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".ui.function.settings.SettingsActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:launchMode="singleTop"
            android:exported="false"/>
        <activity
            android:name=".ui.SplashActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.main.MainActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:launchMode="singleTop"
            android:exported="true">
        </activity>
        <activity
            android:name=".ui.function.WebActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:exported="true"
            tools:ignore="AppLinkUrlError">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wgproGrant" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.function.PreviewActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:launchMode="singleTop"
            android:exported="false" />
        <!-- 强制更新拦截页：不给跳过，所以不进最近任务列表 -->
        <activity
            android:name=".ui.function.settings.UpdateRequiredActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".ui.oobe.OobeActivity"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustPan" />

        <!-- 核心事务：账户会话、设备/XMS 状态 -->
        <service
            android:name=".core.CoreService"
            android:exported="false" />

        <!-- 通知推送：通知中心、私信、未读、实时通道 -->
        <service
            android:name=".core.PushService"
            android:exported="false" />

        <!-- 虚拟设备守护：引擎运行期间常驻前台服务 + 唤醒锁 -->
        <service
            android:name=".core.emu.VelaGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="运行本地虚拟设备（Vela 模拟器），需要持续保持进程与唤醒" />
        </service>

        <!-- 应用下载：前台服务 + 进度通知 -->
        <service
            android:name=".core.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".ui.function.download.DownloadManagerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 虚拟设备详情（与 App/资源详情同构的二级页） -->
        <activity
            android:name=".ui.function.device.VirtualDeviceDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.function.device.VirtualDeviceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.WGProAndroid" />

    </application>

</manifest>
