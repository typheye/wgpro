<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色必须与浅色保持同一套 item：夜间资源里的同名 style 是**整体替换**，
         少写一项就会回落到 M3 基线色（表现为"原生紫色"）。 -->
    <style name="Base.Theme.WGProAndroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/monet_primary</item>
        <item name="colorOnPrimary">@color/monet_on_primary</item>
        <item name="colorPrimaryContainer">@color/monet_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/monet_on_primary_container</item>
        <item name="colorSecondary">@color/monet_secondary</item>
        <item name="colorOnSecondary">@color/monet_on_secondary</item>
        <item name="colorSecondaryContainer">@color/monet_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/monet_on_secondary_container</item>
        <item name="colorTertiary">@color/monet_tertiary</item>
        <item name="colorOnTertiary">@color/monet_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/monet_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/monet_on_tertiary_container</item>
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorOnSurface">@color/monet_on_surface</item>
        <item name="colorSurfaceVariant">@color/monet_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/monet_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorSurfaceBright">@color/surface_primary</item>
        <item name="colorSurfaceDim">@color/surface_secondary</item>
        <item name="colorOutline">@color/monet_outline</item>
        <item name="colorOutlineVariant">@color/monet_outline_variant</item>
        <item name="colorError">@color/monet_error</item>
        <item name="colorOnError">@color/monet_on_error</item>
        <item name="colorErrorContainer">@color/monet_error_container</item>
        <item name="colorOnErrorContainer">@color/monet_on_error_container</item>
        <item name="android:windowBackground">@color/surface_page</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:overScrollMode">never</item>
        <item name="android:colorControlHighlight">?attr/colorPrimaryContainer</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.WGPro.AlertDialog</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="ThemeOverlay.WGPro.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="enableEdgeToEdge">true</item>
        <item name="bottomSheetStyle">@style/Widget.WGPro.BottomSheet.Modal</item>
        <item name="android:colorBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
    </style>
</resources>
