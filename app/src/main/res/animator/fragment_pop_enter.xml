<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator android:duration="140" android:startOffset="50"
        android:interpolator="@android:interpolator/linear_out_slow_in"
        android:propertyName="alpha" android:valueFrom="0.0" android:valueTo="1.0" />
    <objectAnimator android:duration="190"
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:propertyName="scaleX" android:valueFrom="0.94" android:valueTo="1.0" />
    <objectAnimator android:duration="190"
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:propertyName="scaleY" android:valueFrom="0.94" android:valueTo="1.0" />
</set>
