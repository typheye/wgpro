<resources>
    <style name="Base.Theme.WGProAndroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_soft</item>
        <item name="colorSecondary">@color/status_success</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorSurfaceContainer">@color/surface_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline_soft</item>
        <item name="android:windowBackground">@color/surface_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:colorControlHighlight">@color/brand_soft</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.WGPro.AlertDialog</item>
    </style>
    <style name="Theme.WGProAndroid" parent="Base.Theme.WGProAndroid" />
    <style name="Theme.Splash" parent="Theme.WGProAndroid">
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">@color/surface_primary</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="ToolbarTitleAppearance" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.WGPro.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.WGPro.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/surface_primary</item>
    </style>
    <style name="Widget.WGPro.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.WGPro.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.WGPro.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.WGPro.SegmentButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/profile_segment_text</item>
        <item name="backgroundTint">@color/profile_segment_background</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.WGPro.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearanceOverlay.WGPro.AppIcon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22%</item>
    </style>
    <style name="ShapeAppearanceOverlay.WGPro.ProfileSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ThemeOverlay.WGPro.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlayWGProDialog</item>
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="colorSurfaceContainer">@color/surface_elevated</item>
        <item name="colorSurfaceContainerHigh">@color/surface_elevated</item>
        <item name="android:colorBackground">@color/surface_elevated</item>
        <item name="backgroundTint">@color/surface_elevated</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowAnimationStyle">@style/WGPro.DialogAnimation</item>
    </style>
    <style name="ThemeOverlay.WGPro.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="enableEdgeToEdge">true</item>
        <item name="android:navigationBarColor">@color/surface_elevated</item>
        <item name="android:navigationBarDividerColor">@color/surface_elevated</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorSurface">@color/surface_elevated</item>
    </style>
    <style name="WGPro.DialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:windowExitAnimation">@anim/activity_close_exit</item>
    </style>
    <style name="ShapeAppearanceOverlayWGProDialog">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ActivityAnimation" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>
</resources>
