<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page">

    <!-- 内容容器（不滚动、不透明底色）：作为毛玻璃快照源 -->
    <FrameLayout
        android:id="@+id/vd_detail_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/surface_page"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/vd_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingBottom="8dp">

                <!-- 头部：名称 / 发布者 / 来源声明（都锁单行，超出省略） -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="18dp" android:paddingBottom="20dp">
                    <TextView android:id="@+id/vd_detail_title" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="3"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:id="@+id/vd_detail_author" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:background="?attr/selectableItemBackground" android:ellipsize="end"
                        android:maxLines="1" android:singleLine="true" android:textColor="?attr/colorPrimary"
                        android:textSize="16sp" />
                    <TextView android:id="@+id/vd_detail_statement" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:ellipsize="end" android:maxLines="1" android:singleLine="true"
                        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
                </LinearLayout>

                <!-- 数据条：大小 / 下载 / 星标（与应用详情页同一套） -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="72dp"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="14dp" app:cardElevation="0dp" app:strokeWidth="0dp"
                    app:cardPreventCornerOverlap="true" app:cardUseCompatPadding="false">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="horizontal">
                        <LinearLayout android:id="@+id/vd_detail_cell_size" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/vd_detail_size" style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="大小" android:textColor="?attr/colorOnSurfaceVariant"/></LinearLayout>
                        <LinearLayout android:id="@+id/vd_detail_cell_downloads" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/vd_detail_downloads" style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="下载" android:textColor="?attr/colorOnSurfaceVariant"/></LinearLayout>
                                            </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 封面（有才显示）：位置与应用详情页的截图区一致，点击看大图 -->
                <FrameLayout android:id="@+id/vd_detail_cover_scroll"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:visibility="gone">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/vd_detail_cover"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:adjustViewBounds="true" android:scaleType="fitCenter" />
                </FrameLayout>

                <!-- 关于此设备 -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp" android:text="关于此设备" android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/vd_detail_description" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.15" android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="16sp" />

                <!-- 附加信息（没有就不显示） -->
                <LinearLayout android:id="@+id/vd_detail_extra_section"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="28dp" android:text="附加信息" android:textColor="?attr/colorOnSurface"
                        android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:id="@+id/vd_detail_extra"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:lineSpacingMultiplier="1.15"
                        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="16sp" />
                </LinearLayout>

                <!-- 更多 -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp" android:text="更多" android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/vd_detail_info_list"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- 底栏毛玻璃快照层（与应用详情页同款） -->
    <ImageView
        android:id="@+id/vd_detail_blur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:scaleType="matrix"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/vd_detail_action_bar"
        app:layout_constraintBottom_toBottomOf="@id/vd_detail_action_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部栏（动作药丸的父容器）：贴底铺满宽，底部 padding 由 insets 吃掉导航栏 -->
    <LinearLayout
        android:id="@+id/vd_detail_action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_bar"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vd_detail_action"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:rippleColor="?attr/colorPrimary"
            app:strokeWidth="0dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <View android:id="@+id/vd_detail_action_fill"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:background="@drawable/bg_download_fill" />
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="horizontal">
                    <!-- 付费条目：与文字等高的积分图标（tint 跟文字一致）+ 价格 -->
                    <ImageView android:id="@+id/vd_detail_action_icon"
                        android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_marginEnd="5dp" android:contentDescription="@null"
                        android:src="@drawable/ic_points_vector" android:visibility="gone" />
                    <TextView android:id="@+id/vd_detail_action_text"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="获取"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 进度填充区域内的反色文字：与上面同位置，按填充宽度裁剪，
                     这样 49% 时左半是反色、右半是常规色，两边都压在各自底色上 -->
                <TextView android:id="@+id/vd_detail_action_text_fill"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- 下载完成后的「删除」：定长、淡红底（深浅自适应），与左按钮间距 = 原右边距 20dp -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vd_detail_action_delete"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_marginStart="2dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/media_coral"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <TextView android:id="@+id/vd_detail_action_delete_text"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="删除"
                android:textColor="@color/status_danger" android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
