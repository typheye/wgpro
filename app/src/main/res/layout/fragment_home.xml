<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_page" android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginStart="16dp" android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp" android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/surface_primary" app:cardCornerRadius="8dp"
        app:cardElevation="0dp" app:contentPadding="0dp" app:strokeWidth="0dp">
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/home_segments" android:layout_width="match_parent"
            android:layout_height="match_parent" app:checkedButton="@id/home_segment_community"
            app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/home_segment_community"
                style="@style/Widget.WGPro.SegmentButton" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:text="社区" />
            <com.google.android.material.button.MaterialButton android:id="@+id/home_segment_apps"
                style="@style/Widget.WGPro.SegmentButton" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:text="应用" />
            <com.google.android.material.button.MaterialButton android:id="@+id/home_segment_resources"
                style="@style/Widget.WGPro.SegmentButton" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:text="资源" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <com.typheye.wgpro.ui.widget.NestedScrollableHost
            android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.viewpager2.widget.ViewPager2 android:id="@+id/home_pager"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </com.typheye.wgpro.ui.widget.NestedScrollableHost>
        <FrameLayout android:id="@+id/home_page_pool" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone">
            <include android:id="@+id/page_community" layout="@layout/view_empty_community" />
            <include android:id="@+id/page_apps" layout="@layout/view_empty_apps" />
            <include android:id="@+id/page_resources" layout="@layout/view_empty_resources" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
