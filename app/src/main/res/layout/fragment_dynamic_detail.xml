<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/surface_page">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/dynamic_refresh"
        android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dynamic_actions"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp"
                android:paddingEnd="16dp" android:paddingBottom="28dp">
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                    android:layout_height="wrap_content" app:cardBackgroundColor="@color/surface_primary"
                    app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="18dp">
                        <TextView android:id="@+id/dynamic_detail_content" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:lineSpacingMultiplier="1.15"
                            android:textColor="@color/text_primary" android:textSize="17sp" />
                        <ImageView android:id="@+id/dynamic_detail_media" android:layout_width="match_parent"
                            android:layout_height="210dp" android:layout_marginTop="14dp"
                            android:background="@drawable/bg_app_screenshot" android:clipToOutline="true"
                            android:scaleType="centerCrop" android:visibility="gone" />
                        <TextView android:id="@+id/dynamic_detail_tail" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="16dp"
                            android:textColor="@color/text_secondary" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/dynamic_comments_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:layout_marginBottom="10dp" android:text="评论"
                    android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/comment_list" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
                <include android:id="@+id/comment_empty" layout="@layout/view_stream_empty"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <LinearLayout android:id="@+id/dynamic_actions" android:layout_width="0dp"
        android:layout_height="wrap_content" android:background="@color/surface_page"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp"
        android:paddingBottom="8dp" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/dynamic_comment_action"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp"
            android:layout_height="50dp" android:layout_weight="1" android:gravity="start|center_vertical"
            android:paddingStart="20dp" android:text="写评论" android:textColor="@color/text_secondary"
            app:backgroundTint="@color/surface_secondary" app:cornerRadius="25dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dynamic_like_action"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="88dp"
            android:layout_height="50dp" android:layout_marginStart="8dp"
            android:text="赞" android:textColor="@color/text_secondary"
            app:backgroundTint="@color/surface_secondary" app:cornerRadius="25dp"
            app:icon="@drawable/ic_like_vector" app:iconPadding="5dp" app:iconTint="@color/text_secondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dynamic_favorite_action"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="104dp"
            android:layout_height="50dp" android:layout_marginStart="8dp"
            android:text="收藏" android:textColor="@color/text_secondary"
            app:backgroundTint="@color/surface_secondary" app:cornerRadius="25dp"
            app:icon="@drawable/ic_bookmark_vector" app:iconPadding="5dp" app:iconTint="@color/text_secondary" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
