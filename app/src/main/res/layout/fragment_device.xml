<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_page" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView style="@style/TextAppearance.WGPro.Section" android:text="穿戴设备"/>
  <com.google.android.material.card.MaterialCardView android:id="@+id/card_detected_device" style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clickable="true" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="检测到新的小米穿戴设备\n点击立即添加" android:textColor="@color/text_primary"/><TextView android:id="@+id/text_detected_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/brand_on_soft" android:textStyle="bold"/></LinearLayout></com.google.android.material.card.MaterialCardView>
  <LinearLayout android:id="@+id/container_wearable_devices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <com.google.android.material.card.MaterialCardView android:id="@+id/card_wearable_empty" style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@android:color/transparent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_empty_device" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="还没有穿戴设备" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="连接小米手表或手环后，可在这里添加并集中管理。" android:textColor="@color/text_secondary" android:textSize="14sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
  <TextView style="@style/TextAppearance.WGPro.Section" android:layout_marginTop="28dp" android:text="其他设备"/>
  <LinearLayout android:id="@+id/container_other_devices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <com.google.android.material.card.MaterialCardView android:id="@+id/card_other_empty" style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@android:color/transparent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_empty_device" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="暂无其他设备" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="使用同一 Typheye 账户登录的设备会显示在这里。" android:textColor="@color/text_secondary" android:textSize="14sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
 </LinearLayout>
</androidx.core.widget.NestedScrollView>
