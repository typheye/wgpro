<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_page" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingTop="18dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/TextAppearance.WGPro.Section" android:text="小米设备" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="小米运动健康" android:textColor="@color/text_tertiary" android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="58dp" android:layout_height="76dp" android:background="@color/media_blue" android:contentDescription="设备" android:padding="16dp" android:src="@drawable/ic_watch_vector" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <View android:id="@+id/view_device_status_dot" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/status_dot_offline" />
                            <TextView android:id="@+id/text_midevice_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="未连接" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:id="@+id/text_midevice_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="等待发现设备" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Xiaomi Wearable Service" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/linear_midevice_btns" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="end" android:orientation="horizontal" android:visibility="gone">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_midevice_open" style="@style/Widget.WGPro.Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="管理设备" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/card_midevice_help" style="@style/Widget.WGPro.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/status_warning_soft" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="10dp" android:paddingBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="没有发现设备？检查小米运动健康与授权状态" android:textColor="@color/text_primary" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_midevice_help" style="@style/Widget.WGPro.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="帮助" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/TextAppearance.WGPro.Section" android:text="其他设备" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="演示数据" android:textColor="@color/text_tertiary" android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                <TextView android:layout_width="48dp" android:layout_height="48dp" android:background="@color/media_green" android:gravity="center" android:text="手机" android:textColor="@color/banner_green" android:textSize="12sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xiaomi 12 Lite" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Android 16 · 当前设备" android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="在线" android:textColor="@color/status_success" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                <TextView android:layout_width="48dp" android:layout_height="48dp" android:background="@color/media_amber" android:gravity="center" android:text="平板" android:textColor="@color/banner_amber" android:textSize="12sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xiaomi Pad" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Android · 3 天前活跃" android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="离线" android:textColor="@color/text_tertiary" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
