<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/section_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page">

    <!-- 内容铺满整屏，滚动时从应用栏毛玻璃下方穿过 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/section_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/surface_page"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 毛玻璃快照层：与 activity_main.xml 一致，约束在应用栏范围内 -->
    <ImageView
        android:id="@+id/app_bar_blur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:scaleType="matrix"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/section_app_bar"
        app:layout_constraintBottom_toBottomOf="@id/section_app_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="ContentDescription" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/section_app_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_bar"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/section_toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            android:paddingEnd="8dp"
            app:navigationIcon="@drawable/ic_back_vector"
            app:titleTextAppearance="@style/ToolbarTitleAppearance"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/section_loading_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/profile_loading_overlay"
        android:clickable="true"
        android:elevation="32dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/section_app_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
