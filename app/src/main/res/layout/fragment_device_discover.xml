<?xml version="1.0" encoding="utf-8"?>
<!-- 附近设备（扫描）内容：宿主 AddDeviceActivity 的 add_device_fragment_host 内。
     应用栏留白/刷新圈偏移由宿主的 AppBarBlur 递归处理。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<com.typheye.wgpro.ui.widget.WGProRefreshLayout
        android:id="@+id/add_device_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/add_device_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/container_detected_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="vertical">
                <include
                    android:id="@+id/add_device_found_card"
                    layout="@layout/item_device_option"
                    android:layout_marginTop="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- 空态：统一用规范的 view_stream_empty（文案在 Fragment 里按扫描状态设置） -->
                <include
                    android:id="@+id/add_device_empty"
                    layout="@layout/view_stream_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </com.typheye.wgpro.ui.widget.WGProRefreshLayout>
</FrameLayout>
