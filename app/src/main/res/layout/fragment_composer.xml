<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/surface_page"
    android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/composer_title_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="标题" android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/composer_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences" android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/composer_summary_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:hint="摘要" android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/composer_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences" android:maxLength="300" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="内容">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/composer_content"
                android:layout_width="match_parent" android:layout_height="220dp"
                android:gravity="top|start" android:inputType="textCapSentences|textMultiLine"
                android:maxLength="5000" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/composer_note" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textColor="@color/text_secondary" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/composer_submit"
            style="@style/Widget.WGPro.Button.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="发布" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
