<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_page" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingTop="18dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_loginless" style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="登录 Typheye" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="同步收藏、浏览历史、资源与已绑定设备" android:textColor="@color/text_secondary" android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_account_sign_in" style="@style/Widget.WGPro.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="登录" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_account_sign_up" style="@style/Widget.WGPro.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="创建账户" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:id="@+id/linear_logined" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <com.google.android.material.card.MaterialCardView android:id="@+id/profile_card" style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/profile_card_background" app:cardCornerRadius="16dp" app:rippleColor="@color/profile_card_pressed" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="62dp" android:layout_height="62dp" app:cardBackgroundColor="@color/brand_soft" app:cardCornerRadius="31dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <TextView android:id="@+id/text_usr_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/brand_on_soft" android:textSize="25sp" android:textStyle="bold" />
                            <ImageView android:id="@+id/image_usr_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="账户头像" android:scaleType="centerCrop" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/text_usr_nick" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" tools:text="Typheye 用户" />
                        <TextView android:id="@+id/text_usr_uid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="12sp" tools:text="UID: 498978473" />
                        <TextView android:id="@+id/text_usr_shuo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/text_secondary" android:textSize="13sp" tools:text="保持好奇" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_account_edit" style="@style/Widget.WGPro.Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="编辑" android:textColor="@color/brand_on_soft" android:backgroundTint="@color/brand_soft" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:id="@+id/account_stats_card" style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/surface_primary" app:cardCornerRadius="12dp" app:strokeWidth="0dp">
        <LinearLayout android:id="@+id/account_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:weightSum="3">
            <LinearLayout android:id="@+id/account_favorites" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="收藏" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="44dp" android:layout_gravity="center_vertical" android:background="@color/outline_soft" />
            <LinearLayout android:id="@+id/account_history" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="历史" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="44dp" android:layout_gravity="center_vertical" android:background="@color/outline_soft" />
            <LinearLayout android:id="@+id/account_resources" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="资源" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:id="@+id/account_services_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView style="@style/TextAppearance.WGPro.Section" android:layout_marginTop="14dp" android:text="服务" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/account_identity" style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="社区身份" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="普通用户  ›" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:id="@+id/btn_account_goto_help" style="@style/Widget.WGPro.Card" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="账户与安全" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/text_secondary" android:textSize="23sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
