<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_page" android:clickable="true" android:focusable="true"
    android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="28dp" android:paddingEnd="16dp" android:paddingBottom="32dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="92dp" android:layout_height="92dp" android:contentDescription="腕管Pro 应用图标"
            android:elevation="4dp" android:src="@mipmap/ic_launcher" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.WGPro.AppIcon" />
        <TextView style="@style/TextAppearance.Material3.HeadlineMedium" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="腕管Pro" android:textColor="@color/text_primary" android:textStyle="bold" />
        <TextView android:id="@+id/about_version" style="@style/TextAppearance.Material3.BodyMedium" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/status_success_soft" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeWidth="0dp">
            <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:text="为腕上设备持续构建" android:textColor="@color/status_success" android:textSize="12sp" android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.WGPro.Card" android:layout_width="match_parent"
            android:layout_height="96dp" android:layout_marginTop="28dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:weightSum="3">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/about_version_code" style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView style="@style/TextAppearance.Material3.BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="构建版本" android:textColor="@color/text_secondary" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="44dp" android:layout_gravity="center_vertical" android:background="@color/outline_soft" />
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/about_android" style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView style="@style/TextAppearance.Material3.BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="目标 API" android:textColor="@color/text_secondary" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="44dp" android:layout_gravity="center_vertical" android:background="@color/outline_soft" />
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPL" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView style="@style/TextAppearance.Material3.BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="开源协议" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/about_share" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="分享应用" app:icon="@drawable/ic_share_vector" app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
