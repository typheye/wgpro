<?xml version="1.0" encoding="utf-8"?>
<!-- 创建设备（虚拟设备）：结构同 activity_test.xml / SettingsActivity ——
     不滚动的内容容器作为毛玻璃快照源，列表铺满整屏从应用栏下方穿过。 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/create_device_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page">

    <!-- 内容容器（不滚动，作为毛玻璃快照源）+ 内部滚动视图 -->
    <FrameLayout
        android:id="@+id/create_device_content_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_page">

        <com.typheye.wgpro.ui.widget.WGProRefreshLayout
            android:id="@+id/create_device_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/create_device_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="28dp"
                    android:scrollbars="none" />

                <!-- 空态：只 include 规范的 view_stream_empty（父容器已给左右 16dp，故 marginTop=0） -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <include
                        android:id="@+id/create_device_state"
                        layout="@layout/view_stream_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp" />
                </FrameLayout>
            </FrameLayout>
        </com.typheye.wgpro.ui.widget.WGProRefreshLayout>
    </FrameLayout>
        <!-- 进入页面的标准加载遮罩（与用户信息页/预览页同款）：全屏半透明 + 居中转圈 -->
        <FrameLayout
            android:id="@+id/create_device_loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/profile_loading_overlay"
            android:clickable="true"
            android:focusable="true">

            <com.typheye.wgpro.ui.widget.WGProLoadingView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center" />
        </FrameLayout>

    <!-- 应用栏（毛玻璃）：快照层 + 半透明应用栏，声明在内容之后保证画在内容之上 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_bar_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/app_bar_blur"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="false"
            android:focusable="false"
            android:scaleType="matrix"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/app_bar_layout"
            app:layout_constraintBottom_toBottomOf="@id/app_bar_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_bar"
            app:elevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/create_device_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIcon="@drawable/ic_back_vector"
                app:title="创建设备"
                app:titleTextAppearance="@style/ToolbarTitleAppearance"
                app:titleTextColor="?attr/colorOnSurface" />
        </com.google.android.material.appbar.AppBarLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
