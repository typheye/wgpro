<?xml version="1.0" encoding="utf-8"?>
<!-- 模拟设备页：
     顶部 = 水平操作栏（高度自适应，放不下可横滑；上边距=状态栏高度）
     中间 = 显示容器（四层，从下到上：外观皮肤 background.png → 画面 → 显示遮罩扣洞 → 叠加皮肤 foreground.png），左右对齐
     底部 = 日志（默认隐藏，操作栏按钮开关）
     进入页面先盖应用通用的全屏加载遮罩，皮肤渲染完再关，避免闪一下。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/virtual_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 显示容器：左右等边距；顶部留白由代码按"操作栏高度"设置 -->
    <FrameLayout
        android:id="@+id/virtual_device_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">

        <!-- ★ 外观皮肤（background.png）必须**在最底层**（FrameLayout 里越靠后越在上）：
             它铺满整个画布，而有些机型的屏幕区是**不透明黑**（实测 xiaomi_band_pro / redmi_watch
             的 background.png 屏幕中心 alpha=255）—— 压在画面上就是"引擎在跑但一直黑屏"。
             xiaomi_band_10 / xiaomi_s4 的屏幕区本来就是透明的，放最底层同样正确。 -->
        <ImageView
            android:id="@+id/virtual_skin_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="设备外观"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <!-- 画面 + 画面区自绘提示（启动等待/熄屏唤醒都画在这里，不盖应用遮罩） -->
        <view
            class="com.typheye.wgpro.ui.function.device.VirtualDeviceFragment$VirtualScreenView"
            android:id="@+id/virtual_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="模拟设备画面"
            android:scaleType="fitXY" />

        <com.typheye.wgpro.ui.widget.DisplayMaskView
            android:id="@+id/virtual_display_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 叠加皮肤（foreground.png）是**屏幕大小**的玻璃层，画在画面之上 -->
        <ImageView
            android:id="@+id/virtual_skin_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="表圈叠加"
            android:scaleType="fitXY"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 顶部水平操作栏：高度自适应，内容超出可横滑 -->
    <HorizontalScrollView
        android:id="@+id/virtual_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_virtual_actions"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp">
            <ImageView android:id="@+id/key_power" style="@style/VirtualKey" android:contentDescription="电源" android:src="@drawable/ic_key_power" />
            <ImageView android:id="@+id/key_home" style="@style/VirtualKey" android:contentDescription="主页" android:src="@drawable/ic_key_home" />
            <ImageView android:id="@+id/key_back" style="@style/VirtualKey" android:contentDescription="返回" android:src="@drawable/ic_key_back" />
            <ImageView android:id="@+id/key_enter" style="@style/VirtualKey" android:contentDescription="确认" android:src="@drawable/ic_key_enter" />
            <ImageView android:id="@+id/key_vol_up" style="@style/VirtualKey" android:contentDescription="音量加" android:src="@drawable/ic_key_vol_up" />
            <ImageView android:id="@+id/key_vol_down" style="@style/VirtualKey" android:contentDescription="音量减" android:src="@drawable/ic_key_vol_down" />
            <ImageView android:id="@+id/key_log" style="@style/VirtualKey" android:contentDescription="日志" android:src="@drawable/ic_key_log" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 当前设备水印：进页后贴在操作栏下沿，显示"进的是哪一台"（单实例切换时尤其需要） -->
    <TextView
        android:id="@+id/virtual_watermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_watermark"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

    <!-- 日志：默认隐藏；显示时贴底、占屏幕 1/3 高、浮在画面之上 -->
    <ScrollView
        android:id="@+id/virtual_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:clipToPadding="false"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/virtual_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#CCCCCC"
            android:textSize="10sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- 全屏遮罩：与「WebActivity / 应用详情页」同款（盖住整屏，含系统栏）；
         进入本页即显示，皮肤渲染完成后再关，避免刚进来闪一下。 -->
    <FrameLayout
        android:id="@+id/virtual_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/virtual_overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <com.typheye.wgpro.ui.widget.WGProLoadingView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center" />
    </FrameLayout>
</FrameLayout>
