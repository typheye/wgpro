<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page">

    <!-- 内容容器（不滚动、不透明底色）：作为毛玻璃快照源 -->
    <FrameLayout
        android:id="@+id/resource_detail_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/surface_page"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/resource_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingTop="18dp" android:paddingBottom="8dp">
                <TextView android:ellipsize="end" android:maxLines="2" android:id="@+id/resource_detail_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/resource_detail_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15" android:textColor="@color/text_secondary" android:textSize="16sp" />
                <TextView android:id="@+id/resource_detail_meta" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="14dp"
                    android:textColor="@color/text_secondary" android:textSize="13sp" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/surface_secondary"
                    app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                    <TextView android:id="@+id/resource_detail_description" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:lineSpacingMultiplier="1.15"
                        android:padding="16dp" android:textColor="@color/text_primary" android:textSize="16sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- 底栏毛玻璃快照层（与应用详情页同款） -->
    <ImageView
        android:id="@+id/resource_detail_blur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:scaleType="matrix"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/resource_detail_action_bar"
        app:layout_constraintBottom_toBottomOf="@id/resource_detail_action_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部栏（动作药丸的父容器）：贴底铺满宽，底部 padding 由 insets 吃掉导航栏 -->
    <LinearLayout
        android:id="@+id/resource_detail_action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_bar"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resource_detail_action"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:rippleColor="?attr/colorPrimary"
            app:strokeWidth="0dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <View android:id="@+id/resource_detail_action_fill"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:background="@drawable/bg_download_fill" />
                <TextView android:id="@+id/resource_detail_action_text"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="获取"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
