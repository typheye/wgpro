<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_profile_header_dimmed">

    <com.google.android.material.appbar.AppBarLayout android:id="@+id/detail_app_bar"
        android:layout_width="match_parent" android:layout_height="410dp"
        android:background="@drawable/bg_profile_header_dimmed" android:elevation="0dp"
        android:stateListAnimator="@null" android:fitsSystemWindows="true">
        <com.google.android.material.appbar.CollapsingToolbarLayout android:id="@+id/detail_collapsing_toolbar"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:minHeight="112dp"
            android:background="@drawable/bg_profile_header_dimmed" android:fitsSystemWindows="true"
            app:contentScrim="@drawable/bg_profile_header_dimmed"
            app:titleEnabled="false">

            <LinearLayout android:id="@+id/detail_expanded_identity"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="top" android:orientation="vertical"
                android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="48dp"
                android:visibility="invisible"
                app:layout_collapseMode="parallax" app:layout_collapseParallaxMultiplier="0.65">
                <LinearLayout android:id="@+id/detail_avatar_container"
                    android:layout_width="match_parent" android:layout_height="104dp"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <FrameLayout android:layout_width="104dp" android:layout_height="104dp">
                        <TextView android:id="@+id/detail_avatar_text" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:background="@drawable/bg_avatar_placeholder_circle"
                            android:gravity="center" android:textColor="@color/brand_on_soft"
                            android:textSize="42sp" android:textStyle="bold" />
                        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/detail_avatar"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@null" android:padding="0dp"
                            android:scaleType="centerCrop" android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.WGPro.Circle"
                            app:strokeWidth="0dp" />
                    </FrameLayout>
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/detail_follow"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="112dp"
                        android:layout_height="48dp" android:backgroundTint="#40FFFFFF"
                        android:insetTop="0dp" android:insetBottom="0dp" android:text="关注"
                        android:textColor="@color/white" android:visibility="gone"
                        app:cornerRadius="24dp" app:strokeColor="#CCFFFFFF" app:strokeWidth="1dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/detail_message"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp"
                        android:layout_height="48dp" android:layout_marginStart="10dp"
                        android:backgroundTint="#40FFFFFF" android:contentDescription="私信"
                        android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
                        android:visibility="gone" app:cornerRadius="24dp"
                        app:icon="@drawable/ic_message_vector" app:iconGravity="textStart"
                        app:iconPadding="0dp" app:iconTint="@color/white" />
                </LinearLayout>
                <TextView android:id="@+id/detail_nick" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:ellipsize="end" android:maxLines="1"
                    android:textColor="@color/white" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:id="@+id/detail_uid" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textColor="#D9FFFFFF" android:textSize="14sp" />
                <TextView android:id="@+id/detail_bio" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="9dp"
                    android:ellipsize="end" android:maxLines="3"
                    android:textColor="#F2FFFFFF" android:textSize="16sp" />
            </LinearLayout>

            <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
                android:layout_width="match_parent" android:layout_height="88dp" android:minHeight="88dp"
                android:translationY="-12dp"
                android:background="@android:color/transparent" app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_back_vector">
                <LinearLayout android:id="@+id/detail_collapsed_identity"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" android:alpha="0" android:visibility="invisible"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                        <TextView android:id="@+id/detail_collapsed_avatar_text"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar_placeholder_circle" android:gravity="center"
                            android:textColor="@color/brand_on_soft" android:textSize="14sp" android:textStyle="bold" />
                        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/detail_collapsed_avatar"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:scaleType="centerCrop" android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.WGPro.Circle" />
                    </FrameLayout>
                    <TextView android:id="@+id/detail_collapsed_nick" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="10dp"
                        android:maxWidth="180dp" android:ellipsize="end" android:maxLines="1"
                        android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.card.MaterialCardView android:id="@+id/detail_sheet"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:elevation="8dp"
        app:cardBackgroundColor="@color/profile_detail_sheet"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.WGPro.ProfileSheet"
        app:cardElevation="0dp" app:strokeWidth="0dp"
        app:cardUseCompatPadding="false" app:cardPreventCornerOverlap="false"
        app:behavior_draggable="true" app:behavior_fitToContents="false"
        app:behavior_hideable="false" app:behavior_peekHeight="180dp"
        app:layout_behavior="com.typheye.wgpro.ui.widget.ProfileBottomSheetBehavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:orientation="vertical" android:paddingTop="24dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/profile_detail_segments" app:cardCornerRadius="22dp"
                app:cardElevation="0dp" app:strokeWidth="0dp">
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/detail_segments"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    app:checkedButton="@id/detail_segment_activity" app:selectionRequired="true"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/detail_segment_activity"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1" android:text="动态"
                        android:insetLeft="0dp" android:insetTop="0dp"
                        android:insetRight="0dp" android:insetBottom="0dp"
                        android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/profile_segment_text" app:backgroundTint="@color/profile_segment_background"
                        app:cornerRadius="20dp" app:strokeWidth="0dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/detail_segment_favorites"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1" android:text="应用"
                        android:insetLeft="0dp" android:insetTop="0dp"
                        android:insetRight="0dp" android:insetBottom="0dp"
                        android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/profile_segment_text" app:backgroundTint="@color/profile_segment_background"
                        app:cornerRadius="20dp" app:strokeWidth="0dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/detail_segment_resources"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1" android:text="资源"
                        android:insetLeft="0dp" android:insetTop="0dp"
                        android:insetRight="0dp" android:insetBottom="0dp"
                        android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/profile_segment_text" app:backgroundTint="@color/profile_segment_background"
                        app:cornerRadius="20dp" app:strokeWidth="0dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </com.google.android.material.card.MaterialCardView>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <androidx.viewpager2.widget.ViewPager2 android:id="@+id/detail_pager"
                    android:layout_width="match_parent" android:layout_height="match_parent" />
                <FrameLayout android:id="@+id/detail_page_pool" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:visibility="gone">
                    <androidx.core.widget.NestedScrollView android:id="@+id/detail_page_activity"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:clipToPadding="false" android:fillViewport="true">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="32dp">
                            <include layout="@layout/view_empty_community"
                                android:layout_width="match_parent" android:layout_height="300dp" />
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                    <androidx.core.widget.NestedScrollView android:id="@+id/detail_page_favorites"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:clipToPadding="false" android:fillViewport="true" android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="16dp">
                            <include layout="@layout/view_empty_apps"
                                android:layout_width="match_parent" android:layout_height="300dp" />
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                    <androidx.core.widget.NestedScrollView android:id="@+id/detail_page_resources"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:clipToPadding="false" android:fillViewport="true" android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="16dp">
                            <include layout="@layout/view_empty_resources"
                                android:layout_width="match_parent" android:layout_height="300dp" />
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout android:id="@+id/detail_loading_overlay" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="@color/profile_loading_overlay"
        android:clickable="true" android:elevation="32dp" android:focusable="true">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
