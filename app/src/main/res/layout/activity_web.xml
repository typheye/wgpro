<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab"
    tools:context=".ui.function.WebActivity">

    <!-- AppBarLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/tab">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/tab"
                app:title=""
                app:titleTextColor="@color/text_u1"
                app:titleTextAppearance="@style/ToolbarTitleAppearance"
                app:navigationIcon="@drawable/ic_back_vector" />
            <ProgressBar
                android:id="@+id/web_load_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/progress_web_horizontal" />
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <WebView
        android:id="@+id/web_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tab"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- 网页正式开始渲染前的全屏遮罩：登录态同步/加载过程都在这里提示，别写进应用栏 -->
    <FrameLayout
        android:id="@+id/web_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tab"
        android:clickable="true"
        android:focusable="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">
            <com.typheye.wgpro.ui.widget.WGProLoadingView
                android:layout_width="34dp"
                android:layout_height="34dp" />
            <TextView
                android:id="@+id/web_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="加载中…"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
