<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab">

<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab"
    tools:context=".ui.function.WebActivity">

    <!-- AppBarLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/tab">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/tab"
                app:title=""
                app:titleTextColor="?attr/colorOnSurface"
                app:titleTextAppearance="@style/ToolbarTitleAppearance"
                app:navigationIcon="@drawable/ic_back_vector" />
            <ProgressBar
                android:id="@+id/web_load_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/progress_web_horizontal" />
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <WebView
        android:id="@+id/web_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tab"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 全屏遮罩：与「应用详情页」同款，但**盖住整屏（含应用栏）**；
         用于「网页正式开始加载前」的登录态同步与其他数据加载，不跟网页进度联动。 -->
    <FrameLayout
        android:id="@+id/web_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_primary"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <com.typheye.wgpro.ui.widget.WGProLoadingView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center" />
    </FrameLayout>
</FrameLayout>
