<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/surface_page">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/chat_refresh"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/chat_composer"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.core.widget.NestedScrollView android:id="@+id/chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false">
            <LinearLayout android:id="@+id/chat_messages" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="12dp" />
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <LinearLayout android:id="@+id/chat_composer" android:layout_width="0dp"
        android:layout_height="wrap_content" android:background="@color/surface_page"
        android:gravity="bottom" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="8dp"
        android:paddingBottom="8dp" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp"
            app:cardBackgroundColor="@color/surface_secondary" app:cardCornerRadius="26dp"
            app:cardElevation="0dp" app:strokeWidth="0dp">
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/chat_input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@null" android:gravity="center_vertical"
                android:hint="发消息" android:inputType="textCapSentences|textMultiLine"
                android:maxHeight="132dp" android:maxLines="5" android:minHeight="52dp"
                android:paddingStart="18dp" android:paddingTop="10dp" android:paddingEnd="18dp"
                android:paddingBottom="10dp" android:scrollbars="none"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/chat_send"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" android:layout_width="52dp"
            android:layout_height="52dp" android:layout_marginStart="8dp"
            android:contentDescription="发送" android:insetLeft="0dp" android:insetTop="0dp"
            android:insetRight="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:minHeight="0dp"
            android:enabled="false" android:padding="14dp" app:backgroundTint="@color/send_button_background"
            app:cornerRadius="26dp" app:icon="@drawable/ic_send_vector"
            app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/send_button_icon" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
