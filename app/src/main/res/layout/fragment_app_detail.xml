<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page">

    <!-- 内容容器（不滚动、不透明底色）：作为毛玻璃快照源，顶栏 + 底栏共用一份快照 -->
    <FrameLayout
        android:id="@+id/app_detail_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/surface_page"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/app_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:paddingTop="18dp" android:paddingBottom="20dp">
                    <FrameLayout android:layout_width="76dp" android:layout_height="76dp">
                        <TextView
                            android:id="@+id/app_detail_initial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_app_initial_rounded"
                            android:gravity="center"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                        <ImageView android:id="@+id/app_detail_icon" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:background="@drawable/bg_app_icon_clip"
                            android:clipToOutline="true" android:scaleType="centerCrop" android:visibility="gone" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                        <TextView android:id="@+id/app_detail_name" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/text_primary"
                            android:textSize="25sp" android:textStyle="bold" />
                        <TextView android:id="@+id/app_detail_author" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1"
                            android:background="?attr/selectableItemBackground"
                            android:textColor="?attr/colorPrimary" android:textSize="16sp" />
                        <TextView android:id="@+id/app_detail_service" android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:background="?attr/selectableItemBackground"
                            android:ellipsize="end" android:maxLines="1" android:singleLine="true"
                            android:paddingTop="2dp" android:paddingBottom="2dp" android:text="包含应用内服务"
                            android:textColor="@color/text_secondary" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="72dp"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="@color/surface_secondary"
                    app:cardCornerRadius="14dp" app:cardElevation="0dp" app:strokeWidth="0dp"
                    app:cardPreventCornerOverlap="true" app:cardUseCompatPadding="false">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="horizontal">
                        <LinearLayout android:id="@+id/app_detail_cell_size" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/app_detail_size" style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="大小" android:textColor="@color/text_secondary"/></LinearLayout>
                        <LinearLayout android:id="@+id/app_detail_cell_downloads" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/app_detail_downloads" style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="下载" android:textColor="@color/text_secondary"/></LinearLayout>
                        <LinearLayout android:id="@+id/app_detail_cell_stars" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/app_detail_stars" style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="星标" android:textColor="@color/text_secondary"/></LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <HorizontalScrollView android:id="@+id/app_detail_screenshot_scroll"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:clipToPadding="false" android:scrollbars="none">
                    <LinearLayout android:id="@+id/app_detail_screenshots" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- 新特性（应用更新日志）：放在截图下方；没有更新日志时整块隐藏 -->
                <LinearLayout android:id="@+id/app_detail_changelog_section"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="28dp" android:text="新特性" android:textColor="@color/text_primary"
                        android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:id="@+id/app_detail_changelog"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/text_secondary" android:textSize="16sp" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp" android:text="关于此应用" android:textColor="@color/text_primary"
                    android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/app_detail_description" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/text_secondary" android:textSize="16sp" />

                <!-- 附加信息：与网站应用页一致（config 的 app-comment-show）；为空/纯占位符时整块隐藏 -->
                <LinearLayout android:id="@+id/app_detail_extra_section"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="28dp" android:text="附加信息" android:textColor="@color/text_primary"
                        android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:id="@+id/app_detail_extra"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/text_secondary" android:textSize="16sp" />
                </LinearLayout>

                <!-- 更多：接口返回、界面上还没展示过的字段（行由代码按数据动态生成） -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp" android:text="更多" android:textColor="@color/text_primary"
                    android:textSize="22sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/app_detail_info_list"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- 底栏毛玻璃快照层（与动态详情页底栏同款）：约束到应用栏，与其上下边对齐 -->
    <ImageView
        android:id="@+id/app_detail_action_blur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:scaleType="matrix"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/app_detail_action_bar"
        app:layout_constraintBottom_toBottomOf="@id/app_detail_action_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部栏（按钮的父容器）：贴底铺满宽，底部 padding 由 insets 吃掉导航栏（背景延伸到导航条后） -->
    <LinearLayout
        android:id="@+id/app_detail_action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_bar"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/app_detail_action"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:rippleColor="?attr/colorPrimary"
            app:strokeWidth="0dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <View android:id="@+id/app_detail_action_fill"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:background="@drawable/bg_download_fill" />
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="horizontal">
                    <!-- 付费条目：与文字等高的积分图标（tint 跟文字一致）+ 价格 -->
                    <ImageView android:id="@+id/app_detail_action_icon"
                        android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_marginEnd="5dp" android:contentDescription="@null"
                        android:src="@drawable/ic_points_vector" android:visibility="gone" />
                    <TextView android:id="@+id/app_detail_action_text"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="获取"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- 下载完成后的「删除」：定长、淡红底（深浅自适应），与左按钮间距 = 原右边距 20dp -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/app_detail_action_delete"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_marginStart="2dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/media_coral"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <TextView android:id="@+id/app_detail_action_delete_text"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="删除"
                android:textColor="@color/status_danger" android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
