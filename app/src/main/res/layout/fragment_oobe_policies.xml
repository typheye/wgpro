<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/policy_actions"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <ImageView android:layout_width="64dp" android:layout_height="64dp"
                android:background="@drawable/bg_oobe_icon_brand" android:padding="16dp"
                android:src="@drawable/ic_policy_vector" app:tint="@color/brand_on_soft" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:text="隐私，应该简单明了"
                android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="腕管Pro仅在功能需要时申请权限。账户、设备和文件数据不会用于无关用途。"
                android:textColor="@color/text_secondary" android:textSize="16sp" android:lineSpacingExtra="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="34dp" android:text="你始终拥有选择权"
                android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="可以在系统设置中随时管理权限，也可以在应用内退出账户或清除连接信息。"
                android:textColor="@color/text_secondary" android:textSize="15sp" android:lineSpacingExtra="3dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_approve"
                style="@style/Widget.WGPro.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="阅读服务条款与隐私政策"
                app:icon="@drawable/ic_chevron_right_vector"
                app:iconGravity="textEnd" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/policy_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_page"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.WGPro.Button.Tonal"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="上一步"
            app:icon="@drawable/ic_back_vector"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_forward"
            style="@style/Widget.WGPro.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="同意并继续"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
