<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    tools:context=".ui.main.MainActivity">

    <!-- 内容铺满整屏：滚动时从应用栏/导航栏下方穿过（毛玻璃背景） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/surface_page"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 毛玻璃快照层（API 31+ 生效，低版本隐藏，仅半透明底色） -->
    <ImageView
        android:id="@+id/blur_backdrop_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:scaleType="matrix"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/app_bar_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/app_bar_layout"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/blur_backdrop_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:scaleType="matrix"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottom_navigation"
        tools:ignore="ContentDescription" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_bar"
        android:backgroundTint="@color/surface_bar"
        android:elevation="0dp"
        app:backgroundTint="@color/surface_bar"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            app:contentInsetStartWithNavigation="8dp"
            app:titleTextAppearance="@style/ToolbarTitleAppearance"
            app:titleTextColor="?attr/colorOnSurface">

            <!-- 首页专用：占住标题位置的应用栏搜索控件（胶囊底色 + 内嵌放大镜 + 灰字）。
                 放在 Toolbar 里当自定义子视图，测量时会用「右侧菜单左侧的剩余宽度」，
                 所以不会被通知/写一篇图标盖住。首页右侧仍是原生菜单按钮（通知 + 写一篇），
                 切到其它页时搜索框隐藏、恢复标题。边距全用 Toolbar 默认值。 -->
            <TextView
                android:id="@+id/main_search_box"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_home_search_box"
                android:drawableStart="@drawable/ic_search_vector"
                android:drawablePadding="8dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="搜索从这里开始"
                android:textColor="?attr/colorOutline"
                android:textSize="15sp"
                android:visibility="gone" />

        </androidx.appcompat.widget.Toolbar>

        <!-- 当前页面的下划线标签页（首页：动态/应用/资源；设备：穿戴/其他），随页面切换显隐 -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/page_tabs"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/bg_tab_indicator"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabTextAppearance="@style/TextAppearance.WGPro.Tab"
            app:tabTextColor="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_bar"
        android:backgroundTint="@color/surface_bar"
        android:elevation="0dp"
        app:backgroundTint="@color/surface_bar"
        app:elevation="0dp"
        app:itemIconSize="23dp"
        app:itemIconTint="@drawable/bottom_navigation_colors"
        app:itemTextColor="@drawable/bottom_navigation_colors"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_navigation"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
