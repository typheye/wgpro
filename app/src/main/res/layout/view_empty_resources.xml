<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">
    <ImageView android:layout_width="64dp" android:layout_height="64dp"
        android:background="@drawable/bg_oobe_icon_warning" android:padding="16dp"
        android:src="@drawable/ic_bookmark_vector" app:tint="@color/status_warning" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="还没有共享资源"
        android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:gravity="center"
        android:text="用户发布的资源会显示在这里"
        android:textColor="@color/text_secondary" android:textSize="14sp" />
</LinearLayout>
