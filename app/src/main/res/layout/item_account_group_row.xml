<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="58dp"
    android:background="?attr/selectableItemBackground" android:clickable="true"
    android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="18dp" android:paddingEnd="14dp">
    <TextView android:id="@+id/account_row_title" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
    <ImageView android:layout_width="20dp" android:layout_height="20dp"
        android:contentDescription="@null" android:src="@drawable/ic_chevron_right_vector" />
</LinearLayout>
