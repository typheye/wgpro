<?xml version="1.0" encoding="utf-8"?>
<!-- 添加设备（统一入口）：按 EXTRA_MODE 挂不同 Fragment
       wearable → DeviceDiscoverFragment（附近设备/扫描）
       virtual   → VirtualDeviceListFragment（模拟设备机型列表）
     应用栏毛玻璃与 insets 由本页按 _guide/gaosi-mix.md 统一适配（结构同 activity_test.xml）。 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page">

    <!-- 内容容器（不滚动，作为毛玻璃快照源）+ 承载 Fragment 的宿主 -->
    <FrameLayout
        android:id="@+id/add_device_content_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_page">

        <FrameLayout
            android:id="@+id/add_device_fragment_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 进入页面的标准加载遮罩（与用户信息页同款）：首次加载/扫描期间盖住内容 -->
    <FrameLayout
        android:id="@+id/add_device_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/profile_loading_overlay"
        android:clickable="true"
        android:focusable="true">

        <com.typheye.wgpro.ui.widget.WGProLoadingView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- 应用栏（毛玻璃）：快照层 + 半透明应用栏，声明在内容之后保证画在内容之上 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_bar_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/app_bar_blur"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="false"
            android:focusable="false"
            android:scaleType="matrix"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/app_bar_layout"
            app:layout_constraintBottom_toBottomOf="@id/app_bar_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_bar"
            app:elevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/add_device_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIcon="@drawable/ic_back_vector"
                app:title="添加设备"
                app:titleTextAppearance="@style/ToolbarTitleAppearance"
                app:titleTextColor="?attr/colorOnSurface" />
        </com.google.android.material.appbar.AppBarLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
