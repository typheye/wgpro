<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/button_ok"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="腕管Pro"
            android:src="@mipmap/ic_launcher" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:gravity="center"
            android:text="准备就绪" android:textColor="@color/text_primary"
            android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center"
            android:text="去连接设备，探索腕上的更多可能"
            android:textColor="@color/text_secondary" android:textSize="16sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_ok"
        style="@style/Widget.WGPro.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="进入腕管Pro"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
