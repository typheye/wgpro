<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/qr_login_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="请使用已登录 Typheye 的设备扫码"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/qr_login_card"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/brand_soft"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <ImageView
            android:id="@+id/qr_login_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="登录二维码"
            android:padding="12dp"
            android:scaleType="fitCenter" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/qr_login_expiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="二维码将在 5 分钟后失效"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />
</LinearLayout>
