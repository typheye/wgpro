<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_page" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingTop="18dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
        <com.google.android.material.card.MaterialCardView android:id="@+id/tool_file_transfer" style="@style/Widget.WGPro.Card"
            android:layout_width="match_parent" android:layout_height="132dp" android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/banner_blue" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
                <TextView android:layout_width="64dp" android:layout_height="64dp" android:background="@color/brand_soft" android:gravity="center" android:text="⇄" android:textColor="@color/white" android:textSize="30sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="文件传输" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="发送应用、图片与资源到腕上设备" android:textColor="#E5E9FF" android:textSize="14sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/white" android:textSize="28sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/discover_beta"
            style="@style/Widget.WGPro.Card"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/media_green"
            app:rippleColor="@color/status_success_soft"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@color/surface_primary" android:gravity="center" android:text="β" android:textColor="@color/banner_green" android:textSize="21sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="内测计划" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="抢先体验新功能并参与共创" android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="申请" android:textColor="@color/banner_green" android:textSize="13sp" android:textStyle="bold" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="2dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right_vector" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextAppearance.WGPro.Section" android:layout_marginTop="24dp" android:text="常用功能" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical">
                <include android:id="@+id/tool_guide" layout="@layout/item_tool_guide" />
                <include android:id="@+id/tool_diagnostics" layout="@layout/item_tool_diagnostics" />
                <include android:id="@+id/tool_console" layout="@layout/item_tool_console" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
                <include android:id="@+id/tool_scan" layout="@layout/item_tool_scan" />
                <include android:id="@+id/tool_logs" layout="@layout/item_tool_logs" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:text="工具会按需请求权限，不会在后台持续扫描设备。" android:textColor="@color/text_tertiary" android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
