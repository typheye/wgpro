<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_page" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="18dp"
        android:paddingEnd="16dp" android:paddingBottom="24dp">
        <GridLayout android:id="@+id/discover_favorites_grid" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:columnCount="3" android:rowCount="2" android:visibility="gone" />
        <LinearLayout android:id="@+id/discover_more_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:baselineAligned="false" android:orientation="horizontal">
            <LinearLayout android:id="@+id/discover_more_left" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_marginEnd="6dp"
                android:layout_weight="1" android:orientation="vertical" />
            <LinearLayout android:id="@+id/discover_more_right" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:layout_weight="1" android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
