<template>
	<div class="page" @swipe="right">
		<div class="tab">
			<text class="tab-back"></text>
			<marquee class="tab-text">{{ $t("app.name") }}</marquee>
			<text class="tab-more"></text>
		</div>
		<div class="exit">
			<text class="exit-tip-text">{{ tipText }}</text>
			<div class="exit-choose">
				<div
					class="exit-choose-value"
					style="background-color: {{ fc_v1 }}"
					ontouchstart="ht(1, 'v1')"
					ontouchend="ht(0, 'v1')"
					onclick="toBack()"
				>
					<img class="exit-choose-img" src="/common/mipmap/a29.png" />
				</div>
				<div
					class="exit-choose-value"
					style="background-color: {{ fc_v2 }}"
					ontouchstart="ht(1, 'v2')"
					ontouchend="ht(0, 'v2')"
					onclick="toLaunch()"
				>
					<img class="exit-choose-img" src="/common/mipmap/a28.png" />
				</div>
			</div>
		</div>
	</div>
</template>

<script>
export default {
	private: {
		fc_v1: "#3c3c3c",
		fc_v2: "#3c3c3c",
		mode: "",
		tipText: "",
	},
	ht(t, i) {
		if (t == 1) eval("this.fc_" + i + " = 'black'");
		else eval("this.fc_" + i + " = '#3c3c3c'");
	},
	onReady() {
		// mode: legacy（回退旧版） | wgchatx（升级新版）
		this.tipText =
			this.mode == "legacy"
				? this.$t("public.wgchatswitch.tolegacy")
				: this.$t("public.wgchatswitch.tonew");
	},
	onBackPress() {
		this.$app.$def.toCancel(false);
		return true;
	},
	toBack() {
		this.$app.$def.goBack();
	},
	toLaunch() {
		const iswgchatx = this.mode != "legacy";
		// 先落标志位（内存同步生效），再跳转，避免切换后页面读到旧值
		this.$app.$def.settingsChange("wgsettings_iswgchatx", iswgchatx);
		if (iswgchatx)
			this.$app.$def.goReplacePage("pages/ui/function/wgchatx");
		else this.$app.$def.goReplacePage("pages/ui/function/wgchat");
	},
};
</script>

<style>
@import "../../../../common/style/index.css";
@import "../../../../common/style/wgpro.css";
</style>
