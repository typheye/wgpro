<template>
	<div class="page">
		<div class="tab" onclick="toBack()">
			<text class="tab-back">‹</text>
			<marquee class="tab-text">
				{{ $t("acts.settings.tserver.tabtext") }}
			</marquee>
			<text class="tab-more"></text>
		</div>
		<scroll class="scroll-root" scroll-y="true">
			<div class="wgpro-deflayout">
				<div class="wgpro-items-group">
					<div
						class="wgpro-item"
						style="background-color: {{ itc_p1v1 }}"
						ontouchstart="ht(1, 'p1v1')"
						ontouchend="ht(0, 'p1v1')"
						onclick="toRun('wgnotice')"
					>
						<div class="wgpro-item-texts-none">
							<marquee class="wgpro-item-texts-text">
								{{ $t("acts.settings.tserver.p1.item1.text") }}
							</marquee>
							<marquee class="wgpro-item-texts-subtext">
								{{ $t("acts.settings.tserver.p1.item1.subtext") }}
							</marquee>
						</div>
					</div>
					<div
						class="wgpro-item"
						style="background-color: {{ itc_p1v2 }}"
						ontouchstart="ht(1, 'p1v2')"
						ontouchend="ht(0, 'p1v2')"
						onclick="toRun('wgchat')"
					>
						<div class="wgpro-item-texts-none">
							<marquee class="wgpro-item-texts-text">
								{{ chatName }}
							</marquee>
							<marquee class="wgpro-item-texts-subtext">
								{{ chatSub }}
							</marquee>
						</div>
					</div>
				</div>
				<div
					class="exit-choose-value"
					style="margin-top:20px;background-color: {{ itc_p0v0 }}"
					ontouchstart="ht(1, 'p0v0')"
					ontouchend="ht(-1, 'p0v0')"
					onclick="toBack()"
				>
					<img class="exit-choose-img" src="/common/mipmap/a23.png" />
				</div>
				<div class="wgpro-gap-bottom" />
			</div>
		</scroll>
	</div>
</template>

<script>
import storage from "../../../../../utils/storage.js";
export default {
	private: {
		itc_p0v0: "#3c3c3c",
		itc_p1v1: "rgba(0,0,0,0)",
		itc_p1v2: "rgba(0,0,0,0)",
		chatName: "",
		chatSub: "",
	},
	onReady() {
		this.wgchatReady();
	},
	onShow() {
		this.wgchatReady();
	},
	wgchatReady() {
		storage.get({
			key: "wgsettings_iswgchatx",
			success: (data) => {
				const isLegacy = data === false;
				this.chatName = this.$t(
					isLegacy
						? "acts.settings.tserver.p1.item2.text"
						: "acts.settings.tserver.p1.item2.textx"
				);
				this.chatSub = this.$t(
					isLegacy
						? "acts.settings.tserver.p1.item2.subtext"
						: "acts.settings.tserver.p1.item2.subtextx"
				);
			},
			fail: () => {
				this.chatName = this.$t("acts.settings.tserver.p1.item2.textx");
				this.chatSub = this.$t(
					"acts.settings.tserver.p1.item2.subtextx"
				);
			},
		});
	},
	ht(t, i) {
		if (t == 1) eval("this.itc_" + i + " = 'black'");
		else if (t == -1) eval("this.itc_" + i + " = '#3c3c3c'");
		else eval("this.itc_" + i + " = 'rgba(0,0,0,0)'");
	},
	onBackPress() {
		this.$app.$def.toCancel(true);
		return true;
	},
	toBack() {
		this.$app.$def.goBack();
	},
	toRun(id) {
		if (id == "wgchat")
			storage.get({
				key: "wgsettings_iswgchatx",
				success: (data) => {
					if (data === false)
						this.$app.$def.goPage("pages/ui/acts/wgchat/settings");
					else this.$app.$def.goPage("pages/ui/acts/wgchatx/settings");
				},
				fail: () =>
					this.$app.$def.goPage("pages/ui/acts/wgchatx/settings"),
			});
		else if (id == "wgnotice")
			this.$app.$def.toTips(
				this.$t("acts.settings.tserver.p1.item1.text"),
				this.$t("tips.toNull")
			);
	},
};
</script>

<style>
@import "../../../../../common/style/index.css";
@import "../../../../../common/style/wgpro.css";
</style>
