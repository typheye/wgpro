<template>
	<div class="page">
		<div class="tab" onclick="toBack">
			<text class="tab-back">‹</text>
			<marquee class="tab-text">
				{{ roomName }}
			</marquee>
			<text class="tab-more"></text>
		</div>
		<div class="wgpro-frglayout" @swipe="left">
			<list
				id="msgslist"
				class="wgpro-listlayout3"
				bounces="true"
				onscrolltop="onScrollTop"
				onscroll="onScroll"
				onscrollbottom="onScrollBottom"
			>
				<list-item
					class="wgpro-msg-layout"
					for="{{ roommsgList }}"
					type="item1"
					style="margin-top:{{ $item.h1 }}px;height: {{ $item.h0 }}px;"
				>
					<div
						class="wgpro-msg-layout"
						if="{{ $item.isMsg }}"
						onlongpress="showmsginfo($item.num)"
					>
						<div class="wgpro-msg-head" style="height:{{ $item.h2 }};">
							<text class="wgpro-msg-head-text-role" if="{{ $item.h3 }}">
								{{ $item.role }}
							</text>
							<text class="wgpro-msg-head-text-ip" if="{{ $item.h4 }}">
								{{ $item.ip }}
							</text>
							<text class="wgpro-msg-head-text">
								{{ $item.name }}
							</text>
						</div>
						<div class="wgpro-msg-box" style="align-items:{{ $item.align }};">
							<text
								class="wgpro-msg-box-text"
								style="color:{{ $item.textcolor }};background-color:{{ $item.color }};"
							>
								{{ $item.data }}
							</text>
							<div
								class="wgpro-msg-box-file"
								style="border: 5px solid {{ $item.color }};"
								if="{{ $item.hasFile }}"
							>
								<img
									class="wgpro-msg-box-file-img"
									src="/common/mipmap/{{ $item.fileType }}.png"
								/>
								<marquee class="wgpro-msg-box-file-text">
									{{ $item.showFile }}
								</marquee>
							</div>
						</div>
					</div>
					<div class="wgpro-msg-layout" else>
						<text class="wgpro-msg-info">{{ $item.data }}</text>
					</div>
				</list-item>
			</list>
		</div>
	</div>
</template>

<script>
import storage from "../../../../../utils/storage.js";
import store from "../../../../../utils/wgchatx/store.js";
import apiDef from "../../../../../utils/wgchatx/api.js";
export default {
	private: {
		roommsgList: [],
		roomName: "",
		roomId: "",
		taccUid: "",
		isToBottom: false,
		isLoading: false,
		isFetching: false,
		hasMore: true,
		isUserScrolling: false,
		lastScrollY: 0,
		isNearBottom: true,
		maxScrollY: 0,
		meta: null,
	},
	onBackPress() {
		this.$app.$def.toCancel(true);
		return true;
	},
	onInit() {
		this.userReady();
	},
	onReady() {
		this.msgListReady();
		this.$app.$def.taccLoginCheck();
		this.$app.$def.taccGetUserData();
	},
	onShow() {
		this.$app.$def.taccKeepScreenOn(true);
	},
	onDestroy() {
		this.$app.$def.taccKeepScreenOn(false);
	},
	toBack() {
		this.$app.$def.goBack();
	},
	userReady() {
		storage.get({
			key: "wgsettings_taccount_username",
			success: (data) => {
				if (data) this.taccUid = data;
			},
		});
	},
	msgListReady() {
		store.readMeta(this.roomId, (e, meta) => {
			this.meta = meta;
			if (!meta.room || !meta.room.title) {
				meta.room = { id: this.roomId, title: this.roomName || this.roomId };
			}
			if (!this.roomName) this.roomName = meta.room.title;
			const shards = meta.shards || [];
			if (!shards.length) {
				this.msgListUpdate(true);
			} else {
				store.readNewest(
					this.roomId,
					meta,
					apiDef.PAGE_SIZE,
					(e2, list) => {
						this.isLoading = false;
						this.msgLoad(list);
						this.msgListUpdate(false);
					}
				);
			}
		});
	},
	msgListUpdate(can) {
		this.isLoading = true;
		if (!this.meta) {
			store.readMeta(this.roomId, (e, meta) => {
				this.meta = meta;
				this.msgListUpdate(can);
			});
			return;
		}
		const api = apiDef.createApi(this.$app.$def);
		const q = { room_id: this.roomId, limit: apiDef.PAGE_SIZE };
		if (this.meta.latest_id) q.since_id = this.meta.latest_id;
		api.messages(q, (ok, json) => {
			this.isLoading = false;
			if (!ok || !json || !json.items) {
				if (can)
					this.toBack(),
						this.$app.$def.toTips(
							"",
							"加载失败 / code = " + (json ? json.code : "")
						);
				return;
			}
			store.appendNew(this.roomId, this.meta, json.items, (e3, meta) => {
				this.meta = meta;
				store.readNewest(this.roomId, meta, apiDef.PAGE_SIZE, (e4, list) => {
					this.msgLoad(list);
					this.markRead();
				});
			});
		});
	},
	loadOlder() {
		if (this.isFetching || !this.hasMore || !this.meta) return;
		if (!this.meta.oldest_id) return;
		this.isFetching = true;
		const api = apiDef.createApi(this.$app.$def);
		api.messages(
			{ room_id: this.roomId, before_id: this.meta.oldest_id, limit: apiDef.PAGE_SIZE },
			(ok, json) => {
				this.isFetching = false;
				if (!ok || !json || !json.items || !json.items.length) {
					this.hasMore = false;
					return;
				}
				this.hasMore = json.has_more !== false;
				store.insertOlder(this.roomId, this.meta, json.items, (e, meta) => {
					this.meta = meta;
					const older = this.buildItems(json.items);
					this.roommsgList = older.concat(this.roommsgList);
				});
			}
		);
	},
	markRead() {
		if (!this.meta || !this.meta.latest_id) return;
		const api = apiDef.createApi(this.$app.$def);
		api.read(
			{ room_id: this.roomId, last_read_id: this.meta.latest_id },
			() => {}
		);
	},
	msgLoad(list) {
		const timestamp0 = Date.now();
		const roommsgListUpdate = this.buildItems(list);
		// 过滤掉空项
		const realOldMessages = this.roommsgList;
		const realNewMessages = roommsgListUpdate;
		const oldCount = realOldMessages.length;
		const newCount = realNewMessages.length;
		if (newCount != oldCount || realOldMessages == 0) {
			this.roommsgList = roommsgListUpdate;
			const timestamp1 = Date.now();
			const delaytamp = 5 * (timestamp1 - timestamp0);
			this.lastNewMessageTime = timestamp1;
			setTimeout(() => {
				this.toListBottom(true);
			}, delaytamp);
		}
	},
	/**
	 * 把服务端/本地消息数组转成与 wgchat 完全一致的渲染项。
	 */
	buildItems(list) {
		const out = [];
		const timestamp0 = Date.now();
		for (let i = 0; i < list.length; i++) {
			const m = list[i] || {};
			let list_data = m.recalled ? "[已撤回]" : m.content || "";
			let list_num = i;
			let list_h0 = 80;
			let list_h1 = 0;
			let list_h2 = 0;
			let list_h3 = true;
			let list_h4 = true;
			let list_color = "";
			let list_textcolor = "";
			let list_align = "";
			let list_role = "";
			let list_ip = "";
			let list_name = m.sender_nick || "" + (m.sender_uid || "");
			let list_time = m.created_at || "";
			let list_uid = m.sender_uid;
			let list_isMsg = true;
			let list_hasFile = false;
			let list_fileType = "";
			let list_showFile = "";
			let list_fileUri = "";

			const hasMarkers = (str) =>
				str.startsWith("[INFOS]") && str.endsWith("[I:END]");
			const hasMarkersPHOTO = (str) => str.endsWith("[P:END]");
			const hasMarkersAUDIO = (str) => str.endsWith("[A:END]");
			const hasMarkersVIDEO = (str) => str.endsWith("[V:END]");
			const hasMarkersOTHER = (str) => str.endsWith("[O:END]");
			const extractContent = (str) =>
				str.replace(/^\[INFOS\]|\[I:END\]$/g, "");
			const calculateTextHeight = (
				minHeight,
				text,
				charsPerLine = "15",
				lineHeight = "40",
				lineSpacing = "5"
			) => {
				const effectiveLength = [...text].reduce(
					(len, ch) => len + (ch.charCodeAt(0) > 255 ? 2 : 1),
					0
				);
				const lineCount = Math.max(
					1,
					Math.ceil(effectiveLength / charsPerLine)
				);
				return Math.max(
					minHeight,
					lineCount * lineHeight + (lineCount - 1) * lineSpacing
				);
			};

			if (
				hasMarkersPHOTO(list_data) ||
				hasMarkersVIDEO(list_data) ||
				hasMarkersAUDIO(list_data) ||
				hasMarkersOTHER(list_data)
			)
				list_data = "[INFOS]该类型消息暂不支持显示[I:END]";
			if (hasMarkers(list_data)) {
				list_data = extractContent(list_data);
				list_isMsg = false;
				list_h0 = 30 + calculateTextHeight(0, list_data, 30, 30, 3);
				list_h1 = 10;
				list_h2 = 0;
			} else {
				let addh = 0;
				if (false) {
					addh = 70;
					list_hasFile = true;
					list_fileUri = "";
					list_fileType = "b14";
					list_showFile = this.$t("acts.wgchat.room.typeshow." + list_fileType);
				}
			const md = m.metadata || {};
			list_ip = md.address || "";
			const atts = (m.attachments || []).length ? m.attachments : [];
			if (!list_uid) list_uid = "未知"; //没有uid
			if (list_name != "系统消息") list_h3 = false; //没有role
			if (!list_ip) (list_h4 = false), (list_ip = "未知"); //没有ip
			if (list_h3) list_role = "管理员"; //role如果有
			// 附件/特殊消息的文本兜底（保证老客户端也能渲染）
			if (!list_data && atts.length) {
				const k0 = atts[0].kind || "file";
				if (k0 == "image") list_data = "[图片]";
				else if (k0 == "audio") list_data = "[语音]";
				else if (k0 == "video") list_data = "[视频]";
				else {
					const nm = atts[0].extra && atts[0].extra.name;
					list_data = "[文件] " + (nm || "");
				}
			}
			if (!list_data) list_data = "[消息]";
				if ("" + list_uid === "" + this.taccUid) {
					//自己发的消息
					list_h0 = addh + 30 + calculateTextHeight(0, list_data);
					list_h1 = 10;
					list_h2 = 0;
					list_color = "#3EB575";
					list_textcolor = "black";
					list_align = "flex-end";
				} else {
					//别人的
					list_h0 = addh + 70 + calculateTextHeight(0, list_data);
					list_h1 = 10;
					list_h2 = 40;
					list_color = "#3c3c3c";
					list_textcolor = "white";
					list_align = "flex-start";
				}
			}

			out.push({
				num: list_num,
				h0: list_h0,
				h1: list_h1,
				h2: list_h2,
				h3: list_h3,
				h4: list_h4,
				color: list_color,
				textcolor: list_textcolor,
				align: list_align,
				role: list_role,
				ip: list_ip,
				name: list_name,
				data: list_data,
				time: list_time,
				uid: list_uid,
				isMsg: list_isMsg,
				hasFile: list_hasFile,
				fileType: list_fileType,
				showFile: list_showFile,
				fileUri: list_fileUri,
			});
		}
		// 2 个缓冲垫底（与 wgchat 一致，避免最后一条被屏幕底部裁切）
		for (let i = 0; i < 2; i++) {
			out.push({
				num: -1,
				h0: 80,
				h1: 0,
				h2: 0,
				h3: true,
				h4: true,
				color: "",
				textcolor: "",
				align: "",
				role: "",
				ip: "",
				name: "",
				data: "",
				time: "",
				uid: "",
				isMsg: true,
				hasFile: false,
				fileType: "",
				showFile: "",
				fileUri: "",
			});
		}
		return out;
	},
	// 监听滚动事件
	onScroll(e) {
		this.lastScrollY = e.scrollY;
		if (e.scrollState === 1) {
			this.isUserScrolling = true;
		} else if (e.scrollState === 0 || e.scrollState === 2) {
			setTimeout(() => {
				this.isUserScrolling = false;
			}, 500);
		}
		if (e.scrollY > this.maxScrollY) {
			this.maxScrollY = e.scrollY;
		}
	},
	// 判断是否应该滚动到底部的逻辑
	shouldScrollToBottom() {
		if (!this.isUserScrolling) return true;
		return this.checkIfAtBottom();
	},
	checkIfAtBottom() {
		if (this.lastScrollDirection === "down") return true;
		const now = Date.now();
		if (now - this.lastNewMessageTime > 10000) return false;
		return true;
	},
	toListBottom(can) {
		let _behavior = "smooth";
		if (can) _behavior = "instant";
		this.$element("msgslist").scrollTo({
			index: this.roommsgList.length - 1,
			behavior: _behavior,
		});
	},
	onScrollTop() {
		this.loadOlder();
	},
	onScrollBottom() {
		if (!this.isLoading) this.msgListUpdate(false);
	},
	showmsginfo(num) {
		if (num != -1) {
			this.$app.$def.shortVib(true);
			const m = this.roommsgList[num];
			this.$app.$def.toTips(
				this.$t("menu.chatroomlist.msginfotext"),
				this.$app.$def.textFormat(this.$t("menu.chatroomlist.msginfodemo"), {
					usrname: m["name"],
					usruid: m["uid"],
					usrip: m["ip"],
					date: m["time"],
					data: m["data"],
				})
			);
		}
	},
	left(evt) {
		this.$app.$def.settingsChange("wgsettings_wgchat_nowRoomID", this.roomId);
		if (evt.direction === "left") {
			this.$app.$def.shortVib(true);
			this.$app.$def.goReplacePageWithParams("pages/ui/acts/wgchatx/pushmsg", {
				roomName: this.roomName,
				roomId: this.roomId,
			});
		} else if (evt.direction === "right") this.toBack();
	},
};
</script>

<style>
@import "../../../../../common/style/index.css";
@import "../../../../../common/style/wgpro.css";
</style>
