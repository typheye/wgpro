    "eslint-plugin-ux": "^0.0.4"
  },
  "browserslist": [
    "chrome 65"
  ],
  "dependencies": {
    "@aiot-toolkit/jsc": "^1.0.8",
    "less": "^4.4.0",
    "less-loader": "^12.3.0"
  }
