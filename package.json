{
  "name": "wgpro-velawear",
  "version": "3.26.10",
  "description": "腕管Pro Vela 多设备统一构建",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/build.js p62",
    "check": "node scripts/build.js --check",
    "clean": "node scripts/clean.js",
    "build": "node scripts/build.js all --build",
    "build:device": "node scripts/build.js",
    "release": "node scripts/build.js all",
    "release:device": "node scripts/build.js",
    "watch": "aiot watch --open-nuttx",
