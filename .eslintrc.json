{
  "root": true,
  "env": {
    "node": true,
    "commonjs": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:ux/essential"
  ],
  "parserOptions": {
    "parser": "babel-eslint",
    "sourceType": "module",
    "ecmaFeatures": {
      "ecmaVersion": true,
      "jsx": true
    }
  },
  "globals": {
    "loadData": false,
    "saveData": false,
    "history": false,
    "console": false,
    "setTimeout": false,
    "clearTimeout": false,
    "setInterval": false,
    "clearInterval": false
  },
  "rules": {
    "indent": "off",
    "no-console": [
      "warn",
      {
        "allow": [
          "info",
          "warn",
          "error"
        ]
      }
    ],
    "no-unused-vars": [
      "warn",
      {
        "varsIgnorePattern": "prompt"
      }
    ],
    "quotes": [
      "warn",
      "double",
      {
        "avoidEscape": true,
        "allowTemplateLiterals": true
      }
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "linebreak-style": [
      "warn",
      "windows"
    ],
    "semi": [
      "warn",
      "always"
    ],
    "ux/no-parsing-error": "off",
    "ux/valid-v-for": "off"
  }
}
